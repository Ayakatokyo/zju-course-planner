{
  "manifest_version": 3,
  "name": "本机学生来源连接器",
  "version": "0.1.0",
  "description": "在官方已登录页面执行有限只读查询，并将去凭据业务投影交给本机独立来源任务。",
  "host_permissions": ["https://zdbk.zju.edu.cn/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "本机学生来源连接器"},
  "content_scripts": [{
    "matches": ["https://zdbk.zju.edu.cn/*"],
    "js": ["core.js", "content.js"],
    "all_frames": false,
    "run_at": "document_idle"
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
