{
  "metadata": {
    "schema_version": "1.0",
    "prepared_on": "2026-10-09",
    "data_kind": "proposed_import_data_dictionary",
    "page_numbering": "PDF物理页码，从1开始",
    "official_current_version_confirmed": false,
    "user_applicability_confirmed": false,
    "scope_note": "来源为用户上传的2026级培养方案；上传和文字核对不等于已确认当前官方生效版本，也不等于已确认适用于某一学生。"
  },
  "implementation_status": "field_design_only_not_school_api_schema",
  "entity_count": 11,
  "global_conventions": {
    "unknowns": "未提供值用null并配合field_states；unknown不等于false、0、无先修或无冲突。",
    "field_state_enum": [
      "known",
      "unknown",
      "not_provided",
      "not_applicable",
      "pending_verification",
      "conflicting"
    ],
    "identifiers": "内部键与原始学校标识分开；课程号保持字符串，不按近似名称合并。",
    "credit_units": "credits、hours、points、course_count分别建模。",
    "candidate_rule_execution": "23条培养规则全部待人工审核，不能作为已生效官方规则自动执行。",
    "week_semantics": "真实周集合须与学年、学季和校历版本对应；单双周不得只用区间近似。",
    "official_vs_candidates": "正式课表与备选志愿分开；先判断组和状态，再对可能同时生效的教学班做冲突检查。",
    "raw_status_preservation": "保留官方页面原始状态；拟议归一枚举需通过实际来源核验，不宣称是学校API枚举。",
    "data_minimization": "不需要密码、Cookie、账户凭据或带身份/会话参数的链接；本包无个人真实学业数据。",
    "evidence": "源文件名+SHA256+PDF页码，或脱敏来源+快照ID+原文；生成解释与事实来源分开。"
  },
  "support_types": {
    "SourceReference": {
      "fields": {
        "file_name": "string|null",
        "sha256": "string|null",
        "pdf_pages": "array<positive integer>|null",
        "excerpt": "string|null",
        "snapshot_id": "string|null",
        "locator_redacted": "string|null"
      },
      "note": "网页来源只保存不含身份与会话信息的定位；文件页码按PDF物理页。"
    },
    "ConstraintResult": {
      "fields": {
        "rule_id": "string",
        "result": "pass|fail|unknown",
        "reason": "string",
        "source_refs": "array<SourceReference>"
      }
    },
    "CreditAllocation": {
      "fields": {
        "academic_record_id": "string",
        "requirement_id": "string",
        "allocated_credits": "number",
        "allocation_status": "pending|approved"
      }
    }
  },
  "design_reference": {
    "title": "浙江大学选课操作手册",
    "evidence_used": [
      "PDF第6页：非通识同课程多班志愿；通识按上课时间组织多班志愿。",
      "PDF第8页：区分已选上和待定。"
    ],
    "public_url": "https://zdbk.zju.edu.cn/jwglxt/zjdxFilemgr/file_download.html?uid=569CF3B93BFFD98CE0632AB3CA0A55C6",
    "reference_scope": "仅用于志愿组与状态的概念设计；学校实际字段、阶段规则和状态映射需从真实数据核验。"
  },
